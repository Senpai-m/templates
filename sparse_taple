    int fast_query(int l, int r , int ty) {
        int k =  __lg(r - l + 1);
        if (ty == 1)
        return G(t[l][k], t[r - (1LL << k) + 1LL][k]);
        return an(tt[l][k] , tt[r - (1LL << k) + 1LL][k]);
    }
    void print() {
        int LOG = __lg(arr.size()) + 1;
        for (int i = 0; i < arr.size(); i++) {
