struct sparse_taple {
 
    int an(const int& a, const int& b) {
        return (a & b); // a + b , max , gcd , lcm
    }
    int G(const int& a, const int& b) {
        return gcd(a, b);
    }
    void build(int n) {
        for (int i = 0; i < n;  i++) t[i][0] = arr[i];
        for (int i = 0; i < n;  i++) tt[i][0] = arr[i];
        for (int pw = 1 ; (1LL<<pw) <=n; pw++) {
            for (int i = 0 ; i + (1 << pw ) <= n ; i ++) {
                t[i][pw] = G(t[i][pw-1] , t[i + (1LL<<(pw -1))][pw-1]);
                tt[i][pw] =an(tt[i][pw-1] , tt[i + (1LL<<(pw -1))][pw-1]);
            }
        }
    }
